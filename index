                      {/* 宽屏端提示 */}
                      <span className="hidden md:inline">深呼吸，凭直觉点击选牌</span>
                    </span>
                 </div>
               </>
             )}
          </div>
        </div>
      </main>

      {/* --- 全牌库图鉴弹窗 --- */}
      {showGallery && (
        <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/90 backdrop-blur-md transition-opacity p-2 sm:p-6">
