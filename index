            <div className="flex items-center justify-between p-4 sm:p-5 border-b border-indigo-900/50 bg-[#0A1128] rounded-t-2xl">
              <h2 className="text-base sm:text-xl font-serif font-bold flex items-center gap-2 text-amber-200">
