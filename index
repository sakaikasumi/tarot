                        const total = deck.length;
                        const percent = total > 1 ? index / (total - 1) : 0;
                        const normalized = (percent - 0.5) * 2; 
                        const angle = normalized * 25; 
                        const yOffset = Math.abs(Math.pow(normalized, 2)) * 30; 
                        
                        return (
