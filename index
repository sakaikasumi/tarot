                 <div className="absolute bottom-1 sm:bottom-2 left-0 w-full text-center pointer-events-none z-50">
                    <span className="bg-black/60 text-amber-200/60 text-[10px] sm:text-xs px-2 py-0.5 sm:px-4 sm:py-1 rounded-full backdrop-blur-md">
