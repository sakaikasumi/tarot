import React, { useState, useEffect, useRef } from 'react';
import { Sparkles, RefreshCcw, Hand, Info, X, MessageCircle, Star, Image as ImageIcon, BookOpen, Key } from 'lucide-react';

// --- 塔罗牌数据 (完整的78张，分离中英文以供 AI 绘图) ---
const MAJOR_ARCANA = [
  { zh: "愚者", en: "The Fool" }, { zh: "魔术师", en: "The Magician" }, { zh: "女祭司", en: "The High Priestess" }, 
  { zh: "女皇", en: "The Empress" }, { zh: "皇帝", en: "The Emperor" }, { zh: "教皇", en: "The Hierophant" }, 
  { zh: "恋人", en: "The Lovers" }, { zh: "战车", en: "The Chariot" }, { zh: "力量", en: "Strength" }, 
  { zh: "隐士", en: "The Hermit" }, { zh: "命运之轮", en: "Wheel of Fortune" }, { zh: "正义", en: "Justice" }, 
  { zh: "倒吊人", en: "The Hanged Man" }, { zh: "死神", en: "Death" }, { zh: "节制", en: "Temperance" }, 
  { zh: "恶魔", en: "The Devil" }, { zh: "高塔", en: "The Tower" }, { zh: "星星", en: "The Star" }, 
  { zh: "月亮", en: "The Moon" }, { zh: "太阳", en: "The Sun" }, { zh: "审判", en: "Judgement" }, { zh: "世界", en: "The World" }
];
const SUITS = [
  { zh: "权杖", en: "Wands" }, { zh: "圣杯", en: "Cups" }, { zh: "宝剑", en: "Swords" }, { zh: "星币", en: "Pentacles" }
];
const RANKS = [
  { zh: "王牌", en: "Ace of" }, { zh: "二", en: "Two of" }, { zh: "三", en: "Three of" }, { zh: "四", en: "Four of" }, 
  { zh: "五", en: "Five of" }, { zh: "六", en: "Six of" }, { zh: "七", en: "Seven of" }, { zh: "八", en: "Eight of" }, 
  { zh: "九", en: "Nine of" }, { zh: "十", en: "Ten of" }, { zh: "侍从", en: "Page of" }, { zh: "骑士", en: "Knight of" }, 
  { zh: "王后", en: "Queen of" }, { zh: "国王", en: "King of" }
];

const generateDeck = () => {
  let deck = [];
  MAJOR_ARCANA.forEach((card, i) => deck.push({ 
    id: `M${i}`, name: card.zh, prompt: card.en, type: '大阿尔卡那', category: '大阿尔卡那'
  }));
  SUITS.forEach((suit, sIdx) => {
    RANKS.forEach((rank, rIdx) => {
      deck.push({ 
        id: `m${sIdx}-${rIdx}`, 
        name: `${suit.zh}${rank.zh}`, 
        prompt: `${rank.en} ${suit.en}`, 
        type: '小阿尔卡那',
        category: `${suit.zh} (${suit.en})`
      });
    });
  });
  return deck;
};

// 获取固定的卡牌图片 URL
const getCardImageUrl = (prompt, id) => {
  return `https://image.pollinations.ai/prompt/beautiful%20classic%20tarot%20card%20of%20${encodeURIComponent(prompt)}%2C%20intricate%20details%2C%20mystical%2C%20masterpiece?width=300&height=500&nologo=true&seed=${id}`;
};

// --- 经典牌阵定义 ---
const SPREADS = {
  single: {
    id: 'single', name: '每日神谕 (单牌)', description: '抽取一张牌，获得今日的指引或对单一问题的直接回答。',
    positions: [{ id: 'p1', name: '核心指示', x: 50, y: 45 }]
  },
  time: {
    id: 'time', name: '时光之流 (三牌阵)', description: '洞察事物的过去、现在与未来发展脉络。',
    positions: [
      { id: 'p1', name: '过去', x: 20, y: 45 },
      { id: 'p2', name: '现在', x: 50, y: 45 },
      { id: 'p3', name: '未来', x: 80, y: 45 }
    ]
  },
  elements: {
    id: 'elements', name: '四要素牌阵', description: '从土(现状)、火(挑战)、风(思维)、水(情感)全面剖析。',
    positions: [
      { id: 'p1', name: '现状 (土)', x: 50, y: 75 },
      { id: 'p2', name: '挑战 (火)', x: 20, y: 45 },
      { id: 'p3', name: '思维 (风)', x: 80, y: 45 },
      { id: 'p4', name: '情感 (水)', x: 50, y: 15 }
    ]
  }
};

// --- 将单卡渲染组件提取到外部，防止拖拽时引发重复渲染和闪烁 ---
const TarotCard = ({ card, isDragging, mode, onPointerDown }) => {
  const [imgLoaded, setImgLoaded] = useState(false);
  const [imgError, setImgError] = useState(false);
  const aiImageUrl = getCardImageUrl(card.prompt, card.id);

  return (
    <div 
      className={`absolute transform -translate-x-1/2 -translate-y-1/2 w-16 sm:w-20 md:w-24 lg:w-28 xl:w-32 aspect-[2/3] perspective-1000 transition-all duration-500 ${isDragging ? 'scale-110 z-50 shadow-2xl' : 'z-20'} ${mode === 'free' ? 'cursor-grab active:cursor-grabbing' : ''}`}
      style={{ left: `${card.x}%`, top: `${card.y}%`, transitionProperty: isDragging ? 'none' : 'all' }}
      onPointerDown={mode === 'free' ? (e) => onPointerDown(e, card.uniqueId) : undefined}
    >
      <div className={`relative w-full h-full transform-style-3d transition-transform duration-[800ms] ${card.isRevealed ? 'rotate-y-180' : ''}`}>
        
        <div className="absolute inset-0 backface-hidden w-full h-full rounded-lg sm:rounded-xl bg-gradient-to-br from-indigo-900 to-slate-900 border-[1px] sm:border-2 border-amber-600/40 flex items-center justify-center shadow-lg shadow-black/50">
           <div className="w-[85%] h-[90%] border border-amber-500/20 rounded flex items-center justify-center opacity-80">
             <Star className="text-amber-500/50 w-6 h-6 sm:w-10 sm:h-10" />
           </div>
        </div>

        <div className={`absolute inset-0 backface-hidden w-full h-full rounded-lg sm:rounded-xl border-[1px] sm:border-2 border-amber-500/60 shadow-xl shadow-amber-900/20 overflow-hidden rotate-y-180 bg-[#141414] p-0.5 sm:p-1 flex flex-col`}>
          
          <div className={`absolute top-0.5 sm:top-1 left-1/2 transform -translate-x-1/2 z-20 ${card.isRevealed ? 'opacity-100' : 'opacity-0'} transition-opacity duration-700 delay-300`}>
             <div className={`px-1.5 py-0.5 rounded shadow-md text-[6px] sm:text-[8px] font-bold tracking-widest backdrop-blur-md border ${card.isReversed ? 'bg-rose-950/80 text-rose-200 border-rose-500/40' : 'bg-emerald-950/80 text-emerald-200 border-emerald-500/40'}`}>
               {card.isReversed ? '逆位' : '正位'}
             </div>
          </div>

          <div className={`relative w-full h-full border border-amber-500/30 rounded-sm sm:rounded overflow-hidden transition-transform duration-500 ${card.isReversed ? 'rotate-180' : ''}`}>
            {!imgLoaded && !imgError && (
              <div className="absolute inset-0 flex flex-col items-center justify-center bg-slate-800">
                <Star className="text-amber-400/50 animate-spin w-4 h-4 sm:w-6 sm:h-6 mb-1 sm:mb-2" />
                <span className="text-[6px] sm:text-[8px] text-amber-200/50 font-serif">显现中...</span>
              </div>
            )}
            
            {!imgError ? (
              <img 
                src={aiImageUrl} 
                alt={card.name}
                onLoad={() => setImgLoaded(true)}
                onError={() => setImgError(true)}
                className={`absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ${imgLoaded ? 'opacity-100' : 'opacity-0'}`}
                crossOrigin="anonymous"
              />
            ) : (
              <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-700 to-slate-900 flex flex-col items-center justify-center p-2">
                 <div className="w-8 h-8 sm:w-12 sm:h-12 rounded-full border border-amber-400/40 flex items-center justify-center bg-black/30 shadow-inner">
                   {card.type === '大阿尔卡那' ? <Star className="text-amber-300 w-4 h-4 sm:w-6 sm:h-6" /> : <ImageIcon className="text-indigo-300 w-4 h-4 sm:w-6 sm:h-6" />}
                 </div>
              </div>
            )}

            <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/80 to-transparent pt-6 pb-1 sm:pb-2 text-center pointer-events-none">
              <h3 className="text-[10px] sm:text-xs font-serif font-bold text-amber-200 tracking-widest drop-shadow-md">{card.name}</h3>
              <div className="text-[6px] sm:text-[8px] text-amber-200/60 uppercase tracking-widest mt-0.5">{card.prompt}</div>
            </div>
          </div>

        </div>
      </div>
    </div>
  );
};

export default function TarotApp() {
  const [deck, setDeck] = useState([]);
  const [fullLibrary, setFullLibrary] = useState([]); 
  const [mode, setMode] = useState('spread');
  const [currentSpread, setCurrentSpread] = useState('time');
  const [boardCards, setBoardCards] = useState([]); 
  const [question, setQuestion] = useState('');
  const [aiResponse, setAiResponse] = useState('');
  const [isInterpreting, setIsInterpreting] = useState(false);
  const [showReading, setShowReading] = useState(false);
  const [showGallery, setShowGallery] = useState(false); 
  const [isShuffling, setIsShuffling] = useState(false);
  
  // AI 接口连接状态
  const [vertexApiKey, setVertexApiKey] = useState('');

  const [draggingId, setDraggingId] = useState(null);
  const boardRef = useRef(null);

  useEffect(() => {
    const savedKey = localStorage.getItem('vertex_api_key');
    if (savedKey) setVertexApiKey(savedKey);
    
    setFullLibrary(generateDeck());
    handleShuffleAndSpread();
  }, [mode, currentSpread]);

  const saveApiConfig = (key, val) => {
    localStorage.setItem(key, val);
  };

  const handleShuffleAndSpread = () => {
    setIsShuffling(true);
    setBoardCards([]);
    setAiResponse('');
    setShowReading(false);
    
    setTimeout(() => {
      let newDeck = generateDeck();
      for (let i = newDeck.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [newDeck[i], newDeck[j]] = [newDeck[j], newDeck[i]];
      }
      setDeck(newDeck);
      setIsShuffling(false);
    }, 800); 
  };

  const drawCardFromSpread = (deckIndex) => {
    if (deck.length === 0) return;

    const currentDeck = [...deck];
    const card = currentDeck[deckIndex];
    
    let targetX = 50, targetY = 50;
    let targetPosId = null;
    let targetPosName = '';

    if (mode === 'spread') {
      const spreadPositions = SPREADS[currentSpread].positions;
      const emptySlot = spreadPositions.find(p => !boardCards.some(bc => bc.positionId === p.id));
      if (!emptySlot) return; 
      targetX = emptySlot.x;
      targetY = emptySlot.y;
      targetPosId = emptySlot.id;
      targetPosName = emptySlot.name;
    } else {
      targetX = 40 + Math.random() * 20;
      targetY = 30 + Math.random() * 20;
      targetPosId = `free-${Date.now()}`;
      targetPosName = `灵性牌位 ${boardCards.length + 1}`;
    }

    currentDeck.splice(deckIndex, 1);
    setDeck(currentDeck);

    const isReversed = Math.random() > 0.5;
    const uniqueId = Math.random().toString(36).substr(2, 9); 

    const newCard = { 
      ...card, 
      uniqueId,
      isReversed, 
      positionId: targetPosId, 
      positionName: targetPosName,
      x: targetX, 
      y: targetY,
      isRevealed: false 
    };

    setBoardCards(prev => [...prev, newCard]);

    setTimeout(() => {
      setBoardCards(prev => prev.map(c => 
        c.uniqueId === uniqueId ? { ...c, isRevealed: true } : c
      ));
    }, 600);
  };

  const handlePointerDown = (e, id) => {
    if (mode !== 'free') return;
    e.target.setPointerCapture(e.pointerId);
    setDraggingId(id);
  };

  const handlePointerMove = (e) => {
    if (mode !== 'free' || !draggingId || !boardRef.current) return;
    const rect = boardRef.current.getBoundingClientRect();
    let x = ((e.clientX - rect.left) / rect.width) * 100;
    let y = ((e.clientY - rect.top) / rect.height) * 100;
    x = Math.max(5, Math.min(95, x));
    y = Math.max(10, Math.min(90, y));

    setBoardCards(cards => cards.map(c => 
      c.uniqueId === draggingId ? { ...c, x, y } : c
    ));
  };

  const handlePointerUp = (e) => {
    if (draggingId) {
      e.target.releasePointerCapture(e.pointerId);
      setDraggingId(null);
    }
  };

  const canInterpret = mode === 'spread' 
    ? boardCards.length === SPREADS[currentSpread].positions.length 
    : boardCards.length > 0;

  // --- 导师解读逻辑 ---
  const handleInterpret = async () => {
    if (!canInterpret) return;
    
    if (!vertexApiKey) {
      alert("请先在左侧面板配置您的星界连接密钥。");
      return;
    }

    setIsInterpreting(true);
    setShowReading(true);
    setAiResponse('');
    
    const cardsText = boardCards.map(c => 
      `- [${c.positionName}]: ${c.name} (${c.isReversed ? '逆位' : '正位'})`
    ).join('\n');

    const spreadInfo = mode === 'spread' ? SPREADS[currentSpread].name : '随性抽取 (自由摆放)';
    const userQ = question.trim() ? question : '无特定问题，请帮我看看近期的运势、能量流动和指引。';

    const systemPrompt = `你是一位神秘、充满智慧、富有同理心且拥有多年经验的塔罗牌导师。
你的任务是根据求问者的问题、选择的牌阵以及亲手抽到的牌面（含正逆位）进行一次充满灵性深度的解读。
请遵循以下步骤：
1. 【开场引入】：用神秘、温暖的语气打招呼，简述这组牌整体给人的第一直觉或能量流向。
2. 【逐牌解析】：按照求问者抽出的牌位，逐一解读每张牌（结合牌意与它的正逆位）在该位置的象征意义。
3. 【综合洞见】：结合所有牌的联系，给出对问题的整体洞见。
4. 【行动指引】：给出一个温和、具有建设性的具体建议或对未来的祝福。
5. 排版要求：使用 Markdown 格式（适当加粗重点词汇，使用列表等）。`;

    const userPrompt = `
求问者的问题: ${userQ}
使用的牌阵: ${spreadInfo}
求问者抽出的牌阵结果:
${cardsText}

请为求问者进行解读。`;

    const finalPrompt = `${systemPrompt}\n---\n${userPrompt}`;
    
    const modelId = "gemini-3.1-pro-preview";
    const url = `https://aiplatform.googleapis.com/v1/publishers/google/models/${modelId}:generateContent?key=${encodeURIComponent(vertexApiKey.trim())}`;

    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          contents: [
            {
              role: "user", 
              parts: [
                { text: finalPrompt }
              ]
            }
          ],
          generationConfig: {
            temperature: 0.8,
            maxOutputTokens: 4096
          }
        })
      });

      const data = await response.json().catch(() => null);
      
      if (!response.ok) {
        console.error("API full error:", data);
        const errorMessage =
          data?.error?.message ||
          JSON.stringify(data, null, 2) ||
          response.statusText;
        throw new Error(`连接失败 (${response.status}): ${errorMessage}`);
      }

      console.log("API success:", data);
      
      const text = data?.candidates?.[0]?.content?.parts
        ?.map(part => part.text || '')
        .join('\n')
        .trim();

      if (text) {
        setAiResponse(text);
      } else {
        setAiResponse('星辰的力量受到了干扰，未返回可读的指引。请打开控制台查看星盘异动。');
        console.warn("Empty response:", data);
      }
    } catch (error) {
      console.error("AI Error:", error);
      setAiResponse(`连接星界的通道遇到阻碍。\n\n**异象原因**: ${error.message}\n\n请打开浏览器控制台查看完整信息，并核实您的连接密钥是否蕴含真实的魔力。`);
    } finally {
      setIsInterpreting(false);
    }
  };

  const getNextEmptySlotId = () => {
    if (mode !== 'spread') return null;
    const pos = SPREADS[currentSpread].positions.find(p => !boardCards.some(bc => bc.positionId === p.id));
    return pos ? pos.id : null;
  };
  const nextEmptySlotId = getNextEmptySlotId();

  return (
    <div className="min-h-screen bg-[#050B14] text-slate-200 font-sans selection:bg-purple-900 flex flex-col overflow-hidden relative">
      <style dangerouslySetInnerHTML={{__html: `
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.2); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.3); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(167, 139, 250, 0.6); }
        .star-bg {
          background-image: 
            radial-gradient(2px 2px at 20px 30px, #eee, rgba(0,0,0,0)),
            radial-gradient(2px 2px at 40px 70px, #fff, rgba(0,0,0,0)),
            radial-gradient(2px 2px at 50px 160px, #ddd, rgba(0,0,0,0)),
            radial-gradient(2px 2px at 90px 40px, #fff, rgba(0,0,0,0)),
            radial-gradient(2px 2px at 130px 80px, #fff, rgba(0,0,0,0)),
            radial-gradient(2px 2px at 160px 120px, #ddd, rgba(0,0,0,0));
          background-repeat: repeat;
          background-size: 200px 200px;
        }
      `}} />

      <div className="absolute inset-0 star-bg opacity-30 pointer-events-none"></div>
      
      <header className="bg-[#0A1128]/80 backdrop-blur-md border-b border-indigo-900/50 p-3 z-40 relative flex-shrink-0">
        <div className="max-w-[1600px] w-full mx-auto flex justify-between items-center px-2 sm:px-6">
          <div className="flex items-center gap-2">
            <Star className="text-amber-300 fill-amber-300/20 w-5 h-5 sm:w-6 sm:h-6" />
            <h1 className="text-lg sm:text-xl font-serif font-bold tracking-widest bg-gradient-to-r from-amber-200 via-purple-300 to-indigo-300 bg-clip-text text-transparent">
              星辰塔罗占卜
            </h1>
          </div>
          
          <div className="flex bg-[#050811] rounded-full p-1 border border-indigo-900/50">
            <button onClick={() => setMode('spread')} className={`px-3 py-1 sm:px-5 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all duration-300 ${mode === 'spread' ? 'bg-indigo-600 text-amber-50 shadow-lg shadow-indigo-900/50' : 'text-slate-400 hover:text-amber-100'}`}>
              经典牌阵
            </button>
            <button onClick={() => setMode('free')} className={`px-3 py-1 sm:px-5 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all duration-300 ${mode === 'free' ? 'bg-indigo-600 text-amber-50 shadow-lg shadow-indigo-900/50' : 'text-slate-400 hover:text-amber-100'}`}>
              自由摆放
            </button>
          </div>
        </div>
      </header>

      {/* 高度适配：移动端使用 100dvh，规避地址栏遮挡 */}
      <main className="flex-1 w-full max-w-[1600px] mx-auto p-2 sm:p-4 flex flex-col md:flex-row gap-4 sm:gap-6 relative z-10 overflow-hidden h-[calc(100dvh-64px)] md:h-[calc(100vh-64px)]">
        <aside className="w-full md:w-64 lg:w-72 xl:w-80 flex flex-col gap-3 shrink-0 overflow-y-auto custom-scrollbar md:h-full max-h-[35vh] md:max-h-full">
          
          {/* --- 导师配置区 --- */}
          <div className="bg-slate-900/60 backdrop-blur-sm border border-indigo-900/50 rounded-xl p-3 shadow-xl">
            <label className="text-xs font-serif font-medium text-indigo-300 mb-2 flex items-center gap-1.5">
              <Key size={12} className="text-indigo-400" /> 星界连接密钥
            </label>
            <input 
              type="password"
              value={vertexApiKey}
              onChange={(e) => {
                setVertexApiKey(e.target.value);
                saveApiConfig('vertex_api_key', e.target.value);
              }}
              placeholder="请输入您的专属秘钥..."
              className="w-full bg-[#0A1128]/80 border border-indigo-900/60 rounded p-1.5 text-xs text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-indigo-400 transition-all"
            />
          </div>

          <div className="bg-slate-900/60 backdrop-blur-sm border border-indigo-900/50 rounded-xl p-3 sm:p-4 shadow-xl">
            <label className="text-xs sm:text-sm font-serif font-medium text-amber-200/90 mb-2 flex items-center gap-1.5">
              <MessageCircle size={14} className="text-amber-400" /> 在心中默念你的问题
            </label>
            <textarea 
              value={question}
              onChange={(e) => setQuestion(e.target.value)}
              placeholder="你想询问什么？（留空则为整体指引）"
              className="w-full bg-[#0A1128]/80 border border-indigo-900/60 rounded-lg p-2.5 text-xs sm:text-sm text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all resize-none h-16 sm:h-20"
            />
          </div>

          <div className="bg-slate-900/60 backdrop-blur-sm border border-indigo-900/50 rounded-xl p-3 sm:p-4 shadow-xl flex-1 flex flex-col min-h-[150px]">
            {mode === 'spread' ? (
              <div className="flex flex-col gap-2 flex-1 h-full">
                <label className="text-xs sm:text-sm font-serif font-medium text-amber-200/90 flex items-center gap-1.5 mb-1">
                  <Info size={14} className="text-amber-400" /> 挑选一个牌阵
                </label>
                <div className="flex flex-col gap-2 overflow-y-auto custom-scrollbar pr-1 flex-1">
                  {Object.values(SPREADS).map(spread => (
