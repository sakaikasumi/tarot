                               <div className="w-1/2 h-1/2 border border-amber-500/20 rounded-full flex items-center justify-center opacity-40">
                                 <div className="w-[1px] h-[1px] sm:w-1 sm:h-1 bg-amber-400 rounded-full"></div>
                               </div>
                             </div>
                          </div>
                        );
                      })}
